{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ui && npm install --ignore-scripts && npm run build:mock",
  "outputDirectory": "ui/dist",
  "installCommand": "echo 'skip root install'",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|auth/|locales/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
